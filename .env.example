APP_NAME="The Space Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=the_space_management
DB_USERNAME=root
DB_PASSWORD=
# Linux MariaDB/MySQL example; macOS XAMPP: /Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
DB_SOCKET=/var/lib/mysql/mysql.sock

# Local/dev (no Redis required): database drivers below.
# Production (Google VM / VPS): set SESSION_DRIVER=redis, QUEUE_CONNECTION=redis, CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Production Redis (Google VM / VPS) ---
# Uncomment / set these on the server after installing redis-server + php-redis:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
# Laravel 13 uses MAIL_SCHEME + port (not MAIL_ENCRYPTION).
# Hostinger: MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465, MAIL_SCHEME=smtps (recommended).
# Alternative: MAIL_PORT=587 with MAIL_SCHEME=null (STARTTLS) — more prone to handshake failures.
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
# Quote passwords that contain = ^ $ # etc.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional CA bundle if PHP openssl.cafile is empty (fixes Hostinger STARTTLS verify failed).
# Ubuntu: /etc/ssl/certs/ca-certificates.crt  (sudo apt install ca-certificates)
# MAIL_CAFILE=/etc/ssl/certs/ca-certificates.crt
# Notification emails send in-process via dispatchSync (no queue worker required for SMTP).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# AI Setup
OPENAI_API_KEY=
GROQ_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MEDIA_MODEL=gemini-3.5-flash-lite

# WhatsApp Cloud API Setup
WHATSAPP_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Release seed admin (UserAndEmployeeSeeder)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

VITE_APP_NAME="${APP_NAME}"
